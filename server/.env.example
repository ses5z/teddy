# Copy to server/.env and fill in real values. Never commit or share .env.

# Moodle base URL, e.g. https://moodle.example.edu
MOODLE_URL=
# Personal Moodle web service token
MOODLE_TOKEN=

# anthropic | openai
AI_PROVIDER=anthropic
# Leave empty to run in demo mode
AI_API_KEY=
# Optional for anthropic (default claude-opus-5-5), required for openai
AI_MODEL=
# Optional API address; leave empty for the provider default
AI_BASE_URL=
# Optional, openai only: comma-separated models to try when AI_MODEL is busy or out of quota
AI_FALLBACK_MODELS=
